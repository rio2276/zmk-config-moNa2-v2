#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 8
#define SCROLL 9

&trackball {
    scroll-layers = <9>;
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 0 ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    macros {
        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1 &tog_off 2 &tog_off 3 &tog_off 4 &tog_off 5 &tog_off 6 &tog_off 7>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>;

            label = "BT_WIN";
        };

        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1 &tog_off 2 &tog_off 3 &tog_off 4 &tog_off 5 &tog_off 6 &tog_off 7>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 4>;

            label = "BT_MAC";
        };
    };

    behaviors {
        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_1 {
            bindings = <
&lt 10 Q         &kp W         &kp E             &kp R                           &kp T                                                           &kp Y        &kp U  &kp I      &kp O    &lt 8 P
&kp A            &kp S         &kp D             &kp F                           &kp G                                            &kp LS(MINUS)  &kp H        &kp J  &kp K      &kp L    &lt 9 MINUS
&kp Z            &kp X         &kp C             &kp V                           &kp B        &lt 3 TAB                           &lt 10 B       &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&lt 8 LA(GRAVE)  &kp LEFT_ALT  &kp LEFT_COMMAND  &mt LEFT_SHIFT INTERNATIONAL_5  &lt 2 SPACE  &mt LEFT_CONTROL INTERNATIONAL_4    &kp BACKSPACE  &lt 1 ENTER                             &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        win_2 {
            bindings = <
&kp LS(N7)       &kp LS(N8)    &kp LS(N9)        &trans          &kp LS(LEFT_BRACKET)                                     &kp LS(N8)             &kp LS(N9)         &trans       &kp DOLLAR   &kp LEFT_BRACKET
&kp DOLLAR       &kp PERCENT   &kp CARET         &kp SQT         &kp AT_SIGN                               &kp SQT        &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)  &kp AT_SIGN  &kp PERCENT  &kp EQUAL
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH          &kp SEMICOLON   &kp LS(N7)            &kp TAB             &kp SEMICOLON  &kp RIGHT_BRACKET      &kp BACKSLASH      &kp LS(N7)   &kp CARET    &kp LS(EQUAL)
&kp LG(LS(S))    &kp LEFT_ALT  &kp LEFT_COMMAND  &kp LEFT_SHIFT  &trans                &kp LEFT_CONTROL    &kp BACKSPACE  &trans                                                              &kp ESCAPE
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        win_3 {
            bindings = <
&kp F7  &kp F8    &kp F9    &kp F10    &trans                              &kp N7   &kp N8  &kp N9  &kp LS(SEMICOLON)  &kp UNDERSCORE
&kp F4  &kp F5    &kp F6    &kp F11    &trans               &kp LS(MINUS)  &kp N4   &kp N5  &kp N6  &kp EQUAL          &kp MINUS
&kp F1  &kp F2    &kp F3    &kp F12    &trans  &kp TAB      &trans         &kp N1   &kp N2  &kp N3  &kp LS(SQT)        &kp FSLH
&trans  &kp LALT  &kp LGUI  &kp LSHFT  &trans  &kp LCTRL    &kp N0         &kp DOT                                     &kp ESC
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        win_4 {
            bindings = <
&trans  &kp LS(LG(LEFT))    &kp LG(UP_ARROW)  &kp LG(LS(RIGHT))  &trans                                    &trans    &trans          &kp UP_ARROW    &trans           &trans
&trans  &kp LG(LEFT_ARROW)  &kp LG(DOWN)      &kp LG(RIGHT)      &trans                      &kp LS(HOME)  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_UP
&trans  &trans              &trans            &trans             &trans  &trans              &kp LS(END)   &kp END   &trans          &trans          &trans           &kp PAGE_DOWN
&trans  &kp LEFT_ALT        &kp LEFT_COMMAND  &kp LEFT_SHIFT     &trans  &kp LEFT_CONTROL    &trans        &trans                                                     &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        mac_1 {
            bindings = <
&lt 10 Q         &kp W     &kp E             &kp R                 &kp T                                             &kp Y        &kp U  &kp I      &kp O    &lt 8 P
&kp A            &kp S     &kp D             &kp F                 &kp G                                  &kp EQUAL  &kp H        &kp J  &kp K      &kp L    &lt 9 MINUS
&kp Z            &kp X     &kp C             &kp V                 &kp B        &lt 7 TAB                 &lt 10 B   &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH
&lt 8 LC(SPACE)  &kp LALT  &kp LEFT_COMMAND  &mt LEFT_SHIFT LANG2  &lt 6 SPACE  &mt LEFT_CONTROL LANG1    &kp BSPC   &lt 5 ENTER                             &kp ESC
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        mac_2 {
            bindings = <
&kp SQT               &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans          &trans                                                    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans             &kp DOLLAR     &kp AT_SIGN
&kp DOLLAR            &kp PERCENT           &kp AMPERSAND          &kp COLON       &kp LS(DOUBLE_QUOTES)                      &kp COLON      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOUBLE_QUOTES  &kp PERCENT    &kp CARET
&kp EXCLAMATION       &kp DOUBLE_QUOTES     &kp HASH               &kp SEMICOLON   &kp SQT                &kp TAB             &kp SEMICOLON  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SQT            &kp AMPERSAND  &kp TILDE
&kp LS(LC(NUMBER_4))  &kp LEFT_ALT          &kp LEFT_COMMAND       &kp LEFT_SHIFT  &trans                 &kp LEFT_CONTROL    &kp BACKSPACE  &trans                                                                         &kp ESCAPE
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        mac_3 {
            bindings = <
&kp F7  &kp F8        &kp F9            &kp F10         &trans                                 &kp N7   &kp N8  &kp N9  &kp PLUS      &trans
&kp F4  &kp F5        &kp F6            &kp F11         &trans                      &kp EQUAL  &kp N4   &kp N5  &kp N6  &kp CARET     &kp MINUS
&kp F1  &kp F2        &kp F3            &kp F12         &trans  &trans              &trans     &kp N1   &kp N2  &kp N3  &kp ASTERISK  &kp SLASH
&trans  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp LEFT_SHIFT  &trans  &kp LEFT_CONTROL    &kp N0     &kp DOT                                &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        mac_4 {
            bindings = <
&trans  &kp LA(LC(LG(N)))     &kp LA(LC(LG(UP_ARROW)))  &kp LA(LC(LG(P)))      &trans                                         &trans              &trans    &kp UP_ARROW  &trans     &trans
&trans  &kp LA(LC(LG(LEFT)))  &kp LA(LC(LG(DOWN)))      &kp LA(LC(LG(RIGHT)))  &trans                      &kp LC(LS(LEFT))   &kp LC(LEFT_ARROW)  &kp LEFT  &kp DOWN      &kp RIGHT  &kp PAGE_UP
&trans  &trans                &trans                    &trans                 &trans  &trans              &kp LS(LC(RIGHT))  &kp LC(RIGHT)       &trans    &trans        &trans     &kp PAGE_DOWN
&trans  &kp LEFT_ALT          &kp LEFT_COMMAND          &kp LSHIFT             &trans  &kp LEFT_CONTROL    &trans             &trans                                                 &kp ESCAPE
            >;
        };

        MOUSE {
            bindings = <
&kp DELETE  &trans    &kp LC(X)  &kp LC(V)  &kp LC(C)                         &trans      &trans  &trans    &mkp MB2  &trans
&kp BSPC    &trans    &trans     &kp LC(Y)  &kp LC(Z)               &trans    &trans      &trans  &mkp MB1  &mkp MB1  &mkp MB2
&trans      &trans    &trans     &trans     &trans     &trans       &trans    &trans      &trans  &mkp MB3  &mkp MB4  &mkp MB5
&trans      &kp LALT  &kp LGUI   &kp LSHFT  &kp ENTER  &kp LCTRL    &kp BSPC  &kp DELETE                              &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        bt {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt_win  &bt_mac  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans   &trans   &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans   &trans   &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
